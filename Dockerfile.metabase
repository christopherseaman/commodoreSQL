FROM eclipse-temurin:21-jre

USER root

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    fontconfig \
    fonts-dejavu \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Download Metabase
ARG MB_VERSION=v0.58.1
RUN mkdir -p /app && \
    curl -L -o /app/metabase.jar "https://downloads.metabase.com/${MB_VERSION}/metabase.jar"

# Set up directories and permissions
RUN mkdir -p /plugins /metabase-data /home/metabase && \
    chown -R 1000:1000 /app /plugins /metabase-data /home/metabase

WORKDIR /app

ENV MB_PLUGINS_DIR=/plugins \
    MB_DB_FILE=/metabase-data/metabase.db

EXPOSE 3000

# Use script to fix permissions then start as UID 1000
RUN echo '#!/bin/bash\n\
chown -R 1000:1000 /plugins /metabase-data 2>/dev/null || true\n\
exec gosu 1000:1000 java -jar /app/metabase.jar\n\
' > /start.sh && chmod +x /start.sh

CMD ["/start.sh"]

# SuperSet
SUPERSET_SECRET_KEY=b61d18d46eefd4a074c222f246163742

# Set NO_IMPORT to 1 to skip the imports
NO_IMPORT=1

# Set NO_EXPORT to 1 to skip the exports, can run separately with export_all.sh if desired
NO_EXPORT=1

# Database paths
MAIN_DB=/app/data/commodore.duckdb
TEMP_DB=/tmp/temp_duckdb.db

# User and group IDs for file permissions
HOST_UID=1000
HOST_GID=1000

# Set DUCKDB to use something other than `duckdb` from $PATH
# See sql/config.sql for duckdb session config
DUCKDB="duckdb -bail" # How long does it run? Bail on any error

# CSV date for versioning
CSV_DATE="20241211" # Format: YYYYMMDD - matches Bayview.YYYYMMDD.csv.gz

# Table names
SURVEY_TABLE="survey_data_${CSV_DATE}"
IPEDS_TABLE="ipeds_data"
OPTOUT_TABLE="optout_data"

# CSV input files - filenames
SURVEY_CSV="/import/Bayview.20241211.csv.gz"
IPEDS_CSV="/import/hdic_dist_2022_selected.csv"
OPTOUT_CSV="/import/Master_optOut.csv"

# Output directory
OUTPUT_DIR="output"
DESCRIBE_CSV="description.csv"

# Performance settings
MEM_LIMIT="8GB"
NUM_THREADS=8

# Debug settings
DEBUG=true         # Set to true to describe at the end
DEBUG_VERBOSE=true # Set to true to describe at each step

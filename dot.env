# Database paths
MAIN_DB="commodore.db"
TEMP_DB="/tmp/temp_duckdb.db"

# Set NO_EXPORT to 1 to skip the exports, can run separately with export_all.sh if desired
NO_EXPORT=1

# CSV date for versioning
CSV_DATE="20241211"  # Format: YYYYMMDD - matches Bayview.YYYYMMDD.csv.gz

# Table names
SURVEY_TABLE="survey_data_${CSV_DATE}"
IPEDS_TABLE="ipeds_data"
OPTOUT_TABLE="optout_data"

# CSV input files - filenames
SURVEY_CSV="csv/Bayview.20241211.csv.gz"
IPEDS_CSV="csv/hdic_dist_2022_selected.csv"
OPTOUT_CSV="csv/Master_optOut.csv"

# Output directory
OUTPUT_DIR="output"
DESCRIBE_CSV="output/description.csv"

# Performance settings
MEM_LIMIT="16GB"
NUM_THREADS=4

# DuckDB executable path
DUCKDB="duckdb"  # Path to DuckDB executable

# Debug settings
DEBUG=true        # Set to true to describe at the end
DEBUG_VERBOSE=true # Set to true to describe at each step

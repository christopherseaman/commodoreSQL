}

Table master_institution {
  period_sortable varchar [note: 'YYYY-N; part of canonical key']
  unit_id bigint [note: 'IPEDS institution identifier; NULL is one explicit unknown-institution bucket per term']
  state varchar
  control varchar
  level varchar
  size varchar
  institution_name varchar
  institution_type varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  bookstore_url varchar [note: 'Most frequent nonblank URL from all same-term pricing_wide rows; lexical tie-break. This institution-level metadata exception remains a compatibility path.']
  section_count bigint
  advanced_graduate_section_count bigint
  advanced_graduate_directed_study_and_research_section_count bigint
  advanced_undergraduate_section_count bigint
  advanced_undergraduate_graduate_section_count bigint
  general_graduate_section_count bigint
  intermediate_undergraduate_section_count bigint
  introductory_or_general_undergraduate_section_count bigint
  non_degree_credit_section_count bigint
  uncategorized_section_count bigint
  course_count bigint
  material_section_count bigint [note: 'Sections with at least one canonical Use material; equals section_count under the current Master Section population']
  required_section_count bigint [note: 'Material-bearing sections with supply-aware master_section.is_required_direct']
  inferred_required_section_count bigint [note: 'Sections with master_section.required_count > 0']
  optional_section_count bigint
  supply_section_count bigint
  oer_section_count bigint
  ia_section_count bigint
  required_priced_section_count bigint
  optional_priced_section_count bigint
  isbn_section_count bigint
  enrollment_section_count bigint [note: 'Sections with enrollment_assigned']
  seats_taken_section_count bigint [note: 'Sections with non-NULL seats_taken below sentinel 9999']
  enrollments_tot hugeint [note: 'SUM(enrollment_assigned)']
  seats_taken_tot hugeint [note: 'SUM(valid seats_taken)']

  Note: 'Issue #54/#58. One row per term × institution key represented by material-bearing master_section. All section/enrollment/material/pricing denominators use that population. Supply metrics are retained-section sidecar audits. bookstore_url is the explicit metadata exception sourced from all same-term pricing_wide rows.'
}

Table master_isbn {
  period_sortable varchar [note: 'YYYY-N; part of canonical key']
  isbn13 bigint [note: 'Non-NULL ISBN; part of canonical key']
  book_title varchar [note: 'Lexical MIN of trimmed nonblank catalog values']
  author varchar [note: 'Lexical MIN of trimmed nonblank catalog values']
  publisher varchar [note: 'Lexical MIN of trimmed nonblank catalog values']
  is_oer boolean [note: 'Definitive BOOL_OR across catalog rows']
  is_ia boolean [note: 'Definitive BOOL_OR across catalog rows']
  is_supply boolean [note: 'Always false in the canonical Use population']
  unit_id_count bigint
  section_id_count bigint
  course_id_count bigint
  has_enrollment boolean
  enroll_cnt bigint [note: 'Distinct sections with enrollment_assigned']
  enroll_tot hugeint [note: 'SUM(enrollment_assigned) over the distinct section × ISBN spine']
  title_variant_count bigint
  author_variant_count bigint
  publisher_variant_count bigint
  metadata_conflict boolean [note: 'True when any metadata variant count exceeds one']
  price_buy_new_physical_count bigint
  price_buy_new_digital_count bigint
  price_buy_new_na_count bigint
  price_buy_used_physical_count bigint
  price_buy_used_digital_count bigint
  price_buy_used_na_count bigint
  price_buy_na_physical_count bigint
  price_buy_na_digital_count bigint
  price_buy_na_na_count bigint
  price_rental_new_physical_count bigint
  price_rental_new_digital_count bigint
  price_rental_new_na_count bigint
  price_rental_used_physical_count bigint
  price_rental_used_digital_count bigint
  price_rental_used_na_count bigint
  price_rental_na_physical_count bigint
  price_rental_na_digital_count bigint
  price_rental_na_na_count bigint
  institution_type_2_year_private_profit_count bigint
  institution_type_2_year_private_count bigint
  institution_type_2_year_public_count bigint
  institution_type_4_year_private_profit_count bigint
  institution_type_4_year_private_count bigint
  institution_type_4_year_public_count bigint
  institution_type_under_2_year_public_count bigint
  institution_type_unknown_count bigint

  Note: 'Issue #55/#58. One row per term × ISBN consumed from material_costs; Canada, blank ISBN, supply, no-details, and no-material rows are excluded. Pseudo-SKU access codes remain eligible unless classified supply. Price counts are distinct sections with non-NULL material_costs cells.'
}

Table sample10pct_materials {
  isbn13 bigint [pk, note: 'non-NULL catalog ISBN13; part of the canonical material key']
  book_title varchar [note: 'catalog-owned; sourced from course_materials, never copied from pricing_wide']
  author varchar [note: 'catalog-owned; sourced from course_materials, never copied from pricing_wide']
  publisher varchar [note: 'catalog-owned; sourced from course_materials, never copied from pricing_wide']
  imprint varchar [note: 'catalog-owned']
  book_format varchar [note: 'catalog-owned Format value']
  format_type varchar [note: 'catalog-owned FormatType classification input']
  book_status varchar [note: 'catalog-owned raw status']
  isbn_book_title varchar [note: 'term/ISBN lexical-min title used by the downstream Master ISBN compatibility contract']
  isbn_author varchar [note: 'term/ISBN lexical-min author used by the downstream Master ISBN compatibility contract']
  isbn_publisher varchar [note: 'term/ISBN lexical-min publisher used by the downstream Master ISBN compatibility contract']
  isbn_title_variant_count bigint [note: 'term/ISBN distinct nonblank source-title count']
  isbn_author_variant_count bigint [note: 'term/ISBN distinct nonblank source-author count']
  isbn_publisher_variant_count bigint [note: 'term/ISBN distinct nonblank source-publisher count']
  unit_id bigint
  school varchar
  state varchar
  dept_code varchar
  department varchar
  dept_description varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  period varchar
  enrollments integer
  seats_taken integer
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar
  course_id varchar
  section_id varchar [pk, note: 'period-specific section key; part of the canonical material key']
  period_sortable varchar [pk, note: 'YYYY-N; part of the canonical material key']
  period_date date
  is_oer boolean [note: 'catalog-owned definitive BOOL_OR over Use catalog rows']
  oer_category varchar
  is_ia boolean [note: 'catalog-owned definitive BOOL_OR over Use catalog rows']
  ia_category varchar
  is_supply boolean [note: 'always false in canonical Use population; retained for audit contract']
  supply_category varchar
  institution_name varchar
  sector varchar
  level varchar
  control varchar
  size varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  institution_type varchar
  panel_response_year varchar
  is_opted_out boolean
  opt_out_source varchar
  is_required_inferred boolean [note: 'catalog-owned canonical required inference']
  is_post_2024 boolean
  has_isbn boolean
  has_formattype boolean
  has_enrollment boolean
  has_enrollment_own_seats boolean
  no_details boolean
  no_materials boolean
  is_canada boolean
  is_course_material_use boolean
  is_course_material_no_use boolean
  has_enrollment_sibling boolean
  has_enrollment_sibling_seats boolean
  enrollment_assigned integer
  enrollment_source varchar
  is_required_direct boolean [note: 'item-grain literal required nonsupply evidence']
  is_optional_or_recommended_direct boolean [note: 'item-grain optional/recommended literal-status evidence']
  source_row_count bigint [note: 'source catalog rows collapsed into this section-term-ISBN item']
  title_variant_count bigint [note: 'distinct nonblank catalog title values; conflict signal']
  author_variant_count bigint [note: 'distinct nonblank catalog author values; conflict signal']
  publisher_variant_count bigint [note: 'distinct nonblank catalog publisher values; conflict signal']
  imprint_variant_count bigint [note: 'distinct nonblank catalog Imprint values; conflict signal']
  book_format_variant_count bigint [note: 'distinct catalog Format values; conflict signal']
  format_type_variant_count bigint [note: 'distinct catalog FormatType values; conflict signal']
  book_status_variant_count bigint [note: 'distinct catalog status values; conflict signal']
  catalog_metadata_conflict boolean [note: 'TRUE when any catalog metadata variant count exceeds one']
  is_required_inferred_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  is_oer_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  is_ia_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  bookstore_url varchar [note: 'pricing-owned enrichment from pricing_wide; NULL when no pricing match']
  price_buy_new_physical decimal(10,2)
  price_buy_new_digital decimal(10,2)
  price_buy_new_na decimal(10,2)
  price_buy_used_physical decimal(10,2)
  price_buy_used_digital decimal(10,2)
  price_buy_used_na decimal(10,2)
  price_buy_na_physical decimal(10,2)
  price_buy_na_digital decimal(10,2)
  price_buy_na_na decimal(10,2)
  price_rental_new_physical decimal(10,2)
  price_rental_new_digital decimal(10,2)
  price_rental_new_na decimal(10,2)
  price_rental_used_physical decimal(10,2)
  price_rental_used_digital decimal(10,2)
  price_rental_used_na decimal(10,2)
  price_rental_na_physical decimal(10,2)
  price_rental_na_digital decimal(10,2)
  price_rental_na_na decimal(10,2)
  format_count bigint [note: 'pricing_wide count of distinct offered buy/rental option × condition × format tuples, independent of price validity; maximum 18']
  has_buy boolean
  has_rent boolean
  price_min decimal(10,2)
  price_max decimal(10,2)
  price_avg double [note: 'LEGACY midpoint (price_min + price_max) / 2; not arithmetic mean']
  rental_days_min integer
  rental_days_max integer
  price_buy_min decimal(10,2)
  price_buy_max decimal(10,2)
  has_pricing_match boolean [note: 'TRUE when the LEFT pricing_wide join found a section/ISBN row; independent of whether that row has a valid price_min']
  is_section_required_direct boolean [note: 'section-grain direct-required context inherited from comprehensive_data']
  panel_source_row_count bigint [note: 'appended canonical panel multiplicity audit from panel_email']
  panel_response_year_variant_count bigint [note: 'appended canonical panel response-year variant audit']
  use_source_row_count bigint [note: 'appended canonical Use source-row count']
  no_use_source_row_count bigint [note: 'appended canonical NoUse source-row count']
  has_use_source_row boolean [note: 'appended source Use evidence flag']
  has_no_use_source_row boolean [note: 'appended source NoUse evidence flag']
  population_classification_conflict boolean [note: 'appended Use/NoUse disagreement across source rows']
  instructor_variant_count bigint [note: 'appended distinct nonblank instructor count']
  email_variant_count bigint [note: 'appended distinct nonblank email count']
  contact_metadata_conflict boolean [note: 'appended instructor/email conflict signal']
  is_supply_conflict boolean [note: 'appended supply flag conflict signal']
  no_details_conflict boolean [note: 'appended no-details flag conflict signal']
  no_materials_conflict boolean [note: 'appended no-materials flag conflict signal']
  is_canada_conflict boolean [note: 'appended Canada flag conflict signal']
  is_null_isbn_audit boolean [note: 'appended one-NULL-ISBN-row audit marker']
  has_nonnull_isbn_in_section boolean [note: 'appended section has another non-NULL ISBN']
  is_no_adoption_section boolean [note: 'appended section has no non-NULL ISBN adoption']

  Note: 'Issue #81. Materialized by models/sample10pct_materials.sql from material_costs joined to sample10_section_ids on (period_sortable, section_id). Preserves all 130 Material Costs columns and one row per sampled (period_sortable, section_id, isbn13). Membership uses md5-prefix64-mod10-v1 over the complete section population. Current baseline: 1,282,423 rows across 698,578 material-bearing sections.'
}

Table sample10_section_ids {
  section_id varchar [note: 'Canonical sampling unit; one selected row per full section_enrollment key']
  period_sortable varchar
  section_hash ubigint [note: 'First 64 bits of MD5(section_id), interpreted unsigned']
  sample_bucket utinyint [note: 'section_hash modulo 10; always 0 in this membership table']

  Note: 'Issue #53. Deterministic md5-prefix64-mod10-v1 membership over the complete section_enrollment population: 2,359,278 current members with the preserved fingerprint. All sampled stages join this table so whole section clusters and identical membership are preserved; the current Master Section intersection is 698,578 rows.'
}

// ---------------------------------------------------------------------------
// RELATIONSHIPS — Join Keys
// Only true many-to-one refs where the referenced column is unique/PK
// ---------------------------------------------------------------------------

// catalog → dimension/lookup tables (referenced col is PK)
Ref: course_catalog_20251215.FormatType > format_type_classification.FormatType
Ref: course_catalog_20251215.unit_id > ipeds_data.unitid

// comprehensive_data → dimension/lookup tables
Ref: comprehensive_data.FormatType > format_type_classification.FormatType
Ref: comprehensive_data.unit_id > ipeds_data.unitid
Ref: comprehensive_data.email > opt_out.email
Ref: comprehensive_data.email > panel.email
Ref: comprehensive_data.email > panel_email.email

// mailing list chain (email is unique via grouped deterministic top-one selection)
Ref: current_mailing.email > master_mailing.email
Ref: current_mailing.period_sortable > recent_periods.period_sortable

// canonical Course Materials path (composite material keys are documented in table notes)
// course_materials is built from comprehensive_data and material_costs is LEFT-enriched by pricing_wide;
// section_cost and master_isbn consume material_costs. Distinct material_costs
// (period_sortable, section_id) keys define master_section exactly; master_section then
// inherits section fields through comprehensive_data and section_cost 1:1.
Ref: comprehensive_data.section_id > section_enrollment.section_id
Ref: material_costs.section_id > course_materials.section_id

// aggregated views
Ref: master_section.(course_id, period_sortable) > master_course.(course_id, period_sortable)

// ---------------------------------------------------------------------------
// TABLE GROUPS — Pipeline Stages
// ---------------------------------------------------------------------------

TableGroup import_sources {
  course_catalog_20251215
  ipeds_data
  opt_out
  panel
  format_type_classification
  pricing_historical
}

TableGroup import_derived {
  panel_email
  supply_isbn_classification
  state_region
  pricing_wide
  section_enrollment
  comprehensive_data
  course_materials
  course_materials_post_2024
  course_materials_use
  course_materials_no_use
  course_materials_canada
}

TableGroup eda_mailing {
  master_mailing
  recent_periods
  current_mailing
}

TableGroup eda_records {
  material_costs
  section_cost
  master_section
  master_course
  master_institution
  master_isbn
  sample10_section_ids
  sample10pct_materials
}

// ---------------------------------------------------------------------------
// DATA QUALITY — populated by 2d_data_quality.sql; surface for BI dashboards.
// Recreated each pipeline run (snapshot of latest state). Exact pricing-to-catalog
// comparisons happen here without mutating either source-owned pricing table.
// ---------------------------------------------------------------------------

Table __data_quality_metrics {
  category varchar [note: '`catalog`, `pricing`, `wide`, `oer_ia`, or `cross_table`']
  check_id varchar [note: 'short identifier, e.g., dedupe_stages, price_outliers']
  metric_name varchar
  metric_value bigint

  Note: 'Long-format scalar metrics. Recreated on each pipeline run.'
}

Table __data_quality_top_unmatched_ipeds_schools {
  school varchar
  unit_id bigint
  catalog_rows bigint

  Note: 'Top 10 catalog schools whose unit_id is not in IPEDS_2024.csv.'
}

Table __data_quality_null_isbn_breakdown {
  school varchar
  no_book_details bigint [note: 'Title = "*No Book Details*" — non-classroom (research, dissertation, independent study)']
  no_books_required bigint [note: 'Title = "*No Books Required*" — explicit "no textbook required" marker']
  bad_course bigint [note: 'Title = "*Bad Course*" — explicit DQ flag from source']
  other bigint [note: 'Should be 0; nonzero would indicate a new placeholder string in source']
  total_null_isbn bigint

  Note: 'Top 20 schools by NULL ISBN, split by placeholder type. Globally only 3 placeholder strings exist; there are NO genuinely-missing null-ISBN rows.'
}

Table __data_quality_top_null_isbn_schools {
  school varchar
  null_isbn_rows bigint
  non_null_isbn_rows bigint
  total_rows bigint
  null_pct double
  distinct_sections bigint

  Note: 'Top 10 schools by NULL ISBN13 row count (catalog), with proportion of NULL vs total.'
}

Table __data_quality_pricing_match_by_period {
  period_sortable varchar
  pricing_rows bigint
  rows_matched hugeint
  match_pct double

  Note: 'Non-mutating exact (section_id, isbn13) pricing-to-catalog comparison by period.'
}

Table __data_quality_top_unmatched_pricing_sections {
  unit_id integer
  period_sortable varchar
  pricing_sections bigint
  unmatched bigint
  unmatched_pct double

  Note: 'Top 10 (unit_id, period) combinations by unmatched source pricing sections under the exact comparison.'
}

Table __data_quality_format_count_distribution {
  format_count bigint
  pricing_wide_rows bigint

  Note: 'Distribution of format_count values in pricing_wide.'
}

TableGroup data_quality {
  __data_quality_metrics
  __data_quality_top_unmatched_ipeds_schools
  __data_quality_top_null_isbn_schools
  __data_quality_null_isbn_breakdown
  __data_quality_pricing_match_by_period
  __data_quality_top_unmatched_pricing_sections
  __data_quality_format_count_distribution
}

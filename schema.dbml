// ---------------------------------------------------------------------------
// EDA — Canonical material/cost and aggregated records (2b_course_materials.sql,
// 3b_material_costs.sql,
// 4_merged_records.sql, and scripts/sql/models/)
// ---------------------------------------------------------------------------

Table material_costs {
  isbn13 bigint [pk, note: 'non-NULL catalog ISBN13; part of the canonical material key']
  book_title varchar [note: 'catalog-owned; sourced from course_materials, never copied from pricing_wide']
  author varchar [note: 'catalog-owned; sourced from course_materials, never copied from pricing_wide']
  publisher varchar [note: 'catalog-owned; sourced from course_materials, never copied from pricing_wide']
  imprint varchar [note: 'catalog-owned']
  book_format varchar [note: 'catalog-owned Format value']
  format_type varchar [note: 'catalog-owned FormatType classification input']
  book_status varchar [note: 'catalog-owned raw status']
  isbn_book_title varchar [note: 'term/ISBN lexical-min title used by the downstream Master ISBN compatibility contract']
  isbn_author varchar [note: 'term/ISBN lexical-min author used by the downstream Master ISBN compatibility contract']
  isbn_publisher varchar [note: 'term/ISBN lexical-min publisher used by the downstream Master ISBN compatibility contract']
  isbn_title_variant_count bigint [note: 'term/ISBN distinct nonblank source-title count']
  isbn_author_variant_count bigint [note: 'term/ISBN distinct nonblank source-author count']
  isbn_publisher_variant_count bigint [note: 'term/ISBN distinct nonblank source-publisher count']
  unit_id bigint
  school varchar
  state varchar
  dept_code varchar
  department varchar
  dept_description varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  period varchar
  enrollments integer
  seats_taken integer
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar
  course_id varchar
  section_id varchar [pk, note: 'period-specific section key; part of the canonical material key']
  period_sortable varchar [pk, note: 'YYYY-N; part of the canonical material key']
  period_date date
  is_oer boolean [note: 'catalog-owned definitive BOOL_OR over Use catalog rows']
  oer_category varchar
  is_ia boolean [note: 'catalog-owned definitive BOOL_OR over Use catalog rows']
  ia_category varchar
  is_supply boolean [note: 'always false in canonical Use population; retained for audit contract']
  supply_category varchar
  institution_name varchar
  sector varchar
  level varchar
  control varchar
  size varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  institution_type varchar
  panel_response_year varchar
  is_opted_out boolean
  opt_out_source varchar
  is_required_inferred boolean [note: 'catalog-owned canonical required inference']
  is_post_2024 boolean
  has_isbn boolean
  has_formattype boolean
  has_enrollment boolean
  has_enrollment_own_seats boolean
  no_details boolean
  no_materials boolean
  is_canada boolean
  is_course_material_use boolean
  is_course_material_no_use boolean
  has_enrollment_sibling boolean
  has_enrollment_sibling_seats boolean
  enrollment_assigned integer
  enrollment_source varchar
  is_required_direct boolean [note: 'item-grain literal required nonsupply evidence']
  is_optional_or_recommended_direct boolean [note: 'item-grain optional/recommended literal-status evidence']
  source_row_count bigint [note: 'source catalog rows collapsed into this section-term-ISBN item']
  title_variant_count bigint [note: 'distinct nonblank catalog title values; conflict signal']
  author_variant_count bigint [note: 'distinct nonblank catalog author values; conflict signal']
  publisher_variant_count bigint [note: 'distinct nonblank catalog publisher values; conflict signal']
  imprint_variant_count bigint [note: 'distinct nonblank catalog Imprint values; conflict signal']
  book_format_variant_count bigint [note: 'distinct catalog Format values; conflict signal']
  format_type_variant_count bigint [note: 'distinct catalog FormatType values; conflict signal']
  book_status_variant_count bigint [note: 'distinct catalog status values; conflict signal']
  catalog_metadata_conflict boolean [note: 'TRUE when any catalog metadata variant count exceeds one']
  is_required_inferred_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  is_oer_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  is_ia_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  bookstore_url varchar [note: 'pricing-owned enrichment from pricing_wide; NULL when no pricing match']
  price_buy_new_physical decimal(10,2)
  price_buy_new_digital decimal(10,2)
  price_buy_new_na decimal(10,2)
  price_buy_used_physical decimal(10,2)
  price_buy_used_digital decimal(10,2)
  price_buy_used_na decimal(10,2)
  price_buy_na_physical decimal(10,2)
  price_buy_na_digital decimal(10,2)
  price_buy_na_na decimal(10,2)
  price_rental_new_physical decimal(10,2)
  price_rental_new_digital decimal(10,2)
  price_rental_new_na decimal(10,2)
  price_rental_used_physical decimal(10,2)
  price_rental_used_digital decimal(10,2)
  price_rental_used_na decimal(10,2)
  price_rental_na_physical decimal(10,2)
  price_rental_na_digital decimal(10,2)
  price_rental_na_na decimal(10,2)
  format_count bigint [note: 'pricing_wide count of distinct offered buy/rental option × condition × format tuples, independent of price validity; maximum 18']
  has_buy boolean
  has_rent boolean
  price_min decimal(10,2)
  price_max decimal(10,2)
  price_avg double [note: 'LEGACY midpoint (price_min + price_max) / 2; not arithmetic mean']
  rental_days_min integer
  rental_days_max integer
  price_buy_min decimal(10,2)
  price_buy_max decimal(10,2)
  has_pricing_match boolean [note: 'TRUE when the LEFT pricing_wide join found a section/ISBN row; independent of whether that row has a valid price_min']
  is_section_required_direct boolean [note: 'section-grain direct-required context inherited from comprehensive_data']
  panel_source_row_count bigint [note: 'appended canonical panel multiplicity audit from panel_email']
  panel_response_year_variant_count bigint [note: 'appended canonical panel response-year variant audit']
  use_source_row_count bigint [note: 'appended canonical Use source-row count']
  no_use_source_row_count bigint [note: 'appended canonical NoUse source-row count']
  has_use_source_row boolean [note: 'appended source Use evidence flag']
  has_no_use_source_row boolean [note: 'appended source NoUse evidence flag']
  population_classification_conflict boolean [note: 'appended Use/NoUse disagreement across source rows']
  instructor_variant_count bigint [note: 'appended distinct nonblank instructor count']
  email_variant_count bigint [note: 'appended distinct nonblank email count']
  contact_metadata_conflict boolean [note: 'appended instructor/email conflict signal']
  is_supply_conflict boolean [note: 'appended supply flag conflict signal']
  no_details_conflict boolean [note: 'appended no-details flag conflict signal']
  no_materials_conflict boolean [note: 'appended no-materials flag conflict signal']
  is_canada_conflict boolean [note: 'appended Canada flag conflict signal']
  is_null_isbn_audit boolean [note: 'appended one-NULL-ISBN-row audit marker']
  has_nonnull_isbn_in_section boolean [note: 'appended section has another non-NULL ISBN']
  is_no_adoption_section boolean [note: 'appended section has no non-NULL ISBN adoption']

  Note: 'Created by 3b_material_costs.sql. TABLE (materialized), one row per (period_sortable, section_id, isbn13) canonical Use item. Built from course_materials_use and LEFT-enriched from source-owned pricing_wide on the current exact section × ISBN join, so items without usable prices remain. Catalog attributes are never sourced from pricing. Renamed direct-status fields preserve the two former status slots; section context and 17 audit fields append after has_pricing_match (130 total columns). Established current baseline: 12,806,060 rows. Detailed matching evidence is centralized in CMM-ETL.md issue #21 limitation.'
}

Table section_cost {
  section_id varchar [pk]
  course_id varchar
  period_sortable varchar
  required_cost_total_min decimal(38,2)
  required_cost_total_max decimal(38,2)
  optional_cost_total_min decimal(38,2)
  optional_cost_total_max decimal(38,2)
  required_cost_owned_min decimal(38,2)
  required_cost_owned_max decimal(38,2)
  optional_cost_owned_min decimal(38,2)
  optional_cost_owned_max decimal(38,2)
  required_priced_count bigint
  optional_priced_count bigint

  Note: 'TABLE. One row per (period_sortable, section_id) represented by canonical material_costs. Aggregates section-term-ISBN items, required vs non-required via is_required_inferred; owned = buy-only. Joins 1:1 into the material-bearing master_section and feeds master_course cost rollup; it is not the approved item-level input.'
}

Table master_section [note: 'table'] {
  section_id varchar
  course_id varchar
  period varchar
  period_sortable varchar
  period_date date
  // -- material-owned institution fields plus inherited section-canonical dimensions --
  unit_id bigint
  state varchar
  control varchar
  level varchar
  size varchar
  sector varchar
  institution_name varchar
  institution_type varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  school varchar
  department varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  material_count bigint [note: 'COUNT of canonical material_costs section×ISBN items; always >0']
  required_count bigint [note: 'COUNT of material_costs items WHERE is_required_inferred; A/B split key']
  optional_count bigint [note: 'COUNT of material_costs items WHERE NOT is_required_inferred']
  has_course_material_use boolean [note: 'Always true: membership requires at least one canonical Use item']
  course_material_use_count bigint [note: 'Canonical material items; equals material_count']
  course_material_no_use_count bigint [note: 'Co-occurring NoUse catalog rows for retained sections only; sidecar audit']
  no_details_count bigint [note: 'Co-occurring no_details rows for retained sections only; sidecar audit']
  no_materials_count bigint [note: 'Co-occurring no_materials rows for retained sections only; sidecar audit']
  is_canada boolean [note: 'Co-occurring Canada row for a retained section; sidecar audit, not a full-population indicator']
  is_supply boolean [note: '#36: co-occurring classified supply on a retained section; sidecar audit']
  supply_count bigint [note: '#36: co-occurring classified supply rows on a retained section; sidecar audit']
  is_oer boolean [note: 'COALESCE(BOOL_OR(is_oer), FALSE) over canonical material_costs items']
  is_ia boolean
  oer_count bigint
  ia_count bigint
  publishers varchar[] [note: 'LIST(DISTINCT publisher)']
  required_publishers varchar[] [note: 'LIST(DISTINCT publisher) WHERE required']
  required_publisher_count bigint
  optional_publisher_count bigint
  enrollments integer
  seats_taken integer
  // -- coverage (2026-06-04 notes): ISBN presence + OER/IA classifiability --
  has_isbn boolean [note: 'BOOL_OR(has_isbn) over canonical items; true under the current Use contract']
  has_formattype boolean [note: 'BOOL_OR(FormatType present) over canonical items; OER/IA classifiability flag']
  isbn_count bigint [note: 'canonical ISBN items; currently equals material_count']
  classified_count bigint [note: 'canonical items carrying a FormatType']
  // -- enrollment fill-potential flags (diagnostic availability; raw enrollment is NOT imputed).
  //    has_enrollment_* are pure facts (decoupled from has_enrollment); assess a missing
  //    section via NOT has_enrollment AND has_enrollment_*. #32 adds the numeric fill below. --
  has_enrollment boolean [note: 'section carries its own enrollment']
  has_enrollment_sibling boolean [note: 'another section of the same course+period has enrollment']
  has_enrollment_own_seats boolean [note: 'this section has usable seats_taken (<9999)']
  has_enrollment_sibling_seats boolean [note: 'a sibling section has usable seats_taken']
  // -- enrollment fill (#32): persisted numeric imputation + provenance. Raw enrollments
  //    is never overwritten; enrollment_assigned is the filled value. Medians per period
  //    over the reference population (4 BMG course levels x 6 teaching sectors). --
  enrollment_assigned integer [note: '#32: filled enrollment. own -> own_seats(<9999) -> sibling_enroll -> sibling_seats -> class_median(control x level) -> level_median. NULL only when enrollment_source=none']
  enrollment_source varchar [note: 'Fill rung for enrollment_assigned: `own`, `own_seats`, `sibling_enroll`, `sibling_seats`, `class_median`, `level_median`, or `none`']
  is_required_direct boolean [note: 'section-grain supply-aware direct requiredness inherited from material_costs context']
  required_cost_total_min decimal(38,2) [note: 'SUM of per-material price_min over distinct required materials (from section_cost)']
  required_cost_total_max decimal(38,2)
  optional_cost_total_min decimal(38,2)
  optional_cost_total_max decimal(38,2)
  required_cost_owned_min decimal(38,2) [note: 'buy-only (rentals excluded)']
  required_cost_owned_max decimal(38,2)
  optional_cost_owned_min decimal(38,2)
  optional_cost_owned_max decimal(38,2)
  required_cost_avg double [note: '(min+max)/2 — legacy price_avg convention, NOT arithmetic mean']
  required_cost_owned_avg double
  optional_cost_avg double
  required_priced_count bigint [note: 'distinct required materials with ANY price (total coverage; NOT owned-only — can be >0 while owned cost is NULL when priced materials are rental-only)']
  optional_priced_count bigint

  Note: 'TABLE (materialized), currently 6,983,049 rows. Exactly one row per distinct (period_sortable, section_id) in material_costs. Material/OER/coverage/publisher fields aggregate canonical material_costs items; price/cost fields join from section_cost; section fields are inherited through material_costs. Supply, NoUse, Canada, and placeholder fields are course_materials sidecar audits limited to retained material-bearing sections. Validated post-#65 canonical sidecar totals: NoUse 78,230; no_details 25,993; no_materials 145; supply 52,237. Complete-population denominators remain in section_enrollment. DATA-DICTIONARY.md is the authoritative full column dictionary; its embedded MASTER-SECTION-DICTIONARY.md appendix owns the detailed business/NULL/denominator contract.'
}

Table master_course [note: 'view'] {
  course_id varchar
  period_sortable varchar
  period varchar
  period_date date
  // -- institution enrichment (ANY_VALUE; constant per unit_id -> per course) --
  unit_id bigint
  state varchar
  control varchar
  level varchar
  size varchar
  sector varchar
  institution_name varchar
  institution_type varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  school varchar
  department varchar
  course_number varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  section_count bigint
  enrollment_total hugeint
  seats_taken_total hugeint
  total_materials hugeint
  total_required hugeint
  total_optional hugeint
  is_oer boolean [note: 'BOOL_OR across the course sections']
  is_ia boolean
  oer_count hugeint [note: 'SUM of section oer_count']
  ia_count hugeint
  has_isbn boolean [note: 'BOOL_OR across course sections']
  has_formattype boolean
  isbn_count hugeint [note: 'SUM of section isbn_count']
  classified_count hugeint [note: 'SUM of section classified_count']
  has_enrollment_sections bigint [note: 'count of the course''s sections with own enrollment (of section_count)']
  has_enrollment_sibling_sections bigint [note: 'sections with a sibling carrying enrollment']
  has_enrollment_own_seats_sections bigint [note: 'sections with usable own seats_taken']
  has_enrollment_sibling_seats_sections bigint [note: 'sections with a sibling carrying usable seats_taken']
  all_publishers varchar[][] [note: 'nested LIST of publisher arrays']
  unique_required_publishers hugeint
  required_cost_total_min decimal(38,2) [note: 'MIN(min) across sections — cost rolls up MIN/MAX/AVG, NOT SUM (sections share materials)']
  required_cost_total_max decimal(38,2)
  optional_cost_total_min decimal(38,2)
  optional_cost_total_max decimal(38,2)
  required_cost_owned_min decimal(38,2)
  required_cost_owned_max decimal(38,2)
  optional_cost_owned_min decimal(38,2)
  optional_cost_owned_max decimal(38,2)
  required_cost_avg double [note: 'AVG of section (min+max)/2']
  required_cost_owned_avg double
  optional_cost_avg double

  Note: 'One row per material-bearing course-offering (2024+, rolled up from master_section). enrollment_total sums raw master_section.enrollments; enrollment_assigned is not substituted. Cost rolls up from material_costs through section_cost via MIN/MAX/AVG.'
}


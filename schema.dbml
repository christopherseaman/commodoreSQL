  level varchar [note: 'section-canonical scope dimension reused by material_costs']
  sector varchar [note: 'section-canonical scope dimension reused by material_costs']
  course_level varchar [note: 'section mode with lexical tie-break; reused by material_costs for section-scope consistency']
  enrollments integer [note: 'MAX of raw catalog enrollment within the section; source rows remain unchanged']
  seats_taken integer [note: 'MAX of raw catalog seats within the section; 9999 is invalid']
  is_required_direct boolean [note: 'any literal required nonsupply item in the section']
  has_enrollment boolean
  has_enrollment_sibling boolean
  has_enrollment_own_seats boolean
  has_enrollment_sibling_seats boolean
  enrollment_assigned integer [note: 'Exact section enrollment after the documented own/seats/sibling/median hierarchy; NULL only when no rung is available']
  enrollment_source varchar [note: '`own`, `own_seats`, `sibling_enroll`, `sibling_seats`, `class_median`, `level_median`, or `none`']

  Note: 'Created by 1b_section_enrollment.sql. Materialized one row per valid 2024+ (period_sortable, section_id). Owns the complete section population, supply-aware direct requiredness, authoritative raw enrollment/flags, section-scope dimensions, and assigned-enrollment value/provenance. comprehensive_data inherits its section fields.'
}


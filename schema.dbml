// CommodoreSQL — Data Landscape
// Course catalog + institutional + pricing pipeline for OER/IA analysis
// Pipeline: IMPORT (CSV → tables/views) → EDA (tables/views/models) → EXPORT (CSV) → Metabase

Project CommodoreSQL {
  database_type: 'DuckDB'
  Note: '''
    ## Metabase config-as-code — see metabase/
    - 62 SQL questions spanning canonical material/section analysis, reports, and raw/DQ diagnostics
    - 4 Models: Master Section, its Fall-2025 required intro/non-Canada-state scope, Master Institution, and Master ISBN
    - 13 dashboards, including BMG, report, OER/IA, coverage, lineage, and data-quality surfaces
  '''
}

// ---------------------------------------------------------------------------
// SOURCE DATA FILES
// ---------------------------------------------------------------------------

// Database: duckdb/commodore.duckdb

Enum source_files {
  "data/2025.12.15/2025_12/DiscoveryExtract.20251215.csv" [note: 'BMG course-materials source → compatibility table course_catalog_20251215 (~103M rows)']
  "data/2025.12.15/IPEDS_2024.csv" [note: 'IPEDS institution metadata → compatibility table ipeds_data (~7K rows)']
  "data/2025.12.15/OptOut_20251215.csv" [note: 'BVA opt-out source → compatibility table opt_out']
  "data/2025.12.15/panel_20260108.csv" [note: 'BVA mailing/panel history → compatibility table panel']
  "data/2025.12.15/format_type_lookup.tsv" [note: '→ format_type_classification (69 rows)']
  "data/BookPricing.Historical_20260224.csv" [note: 'BMG raw pricing/cost observations → compatibility table pricing_historical (~27.3M current rows)']
  "scripts/sql/lookups/supply_keywords.tsv" [note: 'CMM-owned → supply_isbn_classification; 97 include + 26 exclude title patterns']
}

// ---------------------------------------------------------------------------
// IMPORT — Source Tables (CSV loads)
// ---------------------------------------------------------------------------

Table course_catalog_20251215 {
  ISBN13 bigint
  Title varchar
  Author varchar
  Publisher varchar
  Imprint varchar
  Format varchar
  FormatType varchar
  book_status varchar [note: 'lowercase: required, recommended, option, NULL']
  unit_id bigint
  school varchar
  state varchar
  dept_code varchar
  department varchar
  dept_description varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  period varchar [note: 'e.g. "Fall 2024"']
  enrollments integer
  seats_taken integer
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar [note: 'cleaned/normalized from raw E-Mail']
  course_id varchar [note: 'unit_id::dept_code::course_number']
  section_id varchar [note: 'unit_id::dept_code::course_number::section::period_sortable — includes period so each section-offering is unique']
  period_sortable varchar [note: 'YYYY-N where 1=Winter 2=Spring 3=Summer 4=Fall']
  period_date date [note: 'canonical: 01-01, 04-01, 07-01, 10-01']

  indexes {
    email [name: 'idx_course_email']
    unit_id [name: 'idx_course_unitid']
    period_sortable [name: 'idx_course_period']
    course_id [name: 'idx_course_courseid']
    section_id [name: 'idx_course_sectionid']
  }

  Note: '~103M rows. BMG source: DiscoveryExtract CSV. Compatibility-named central fact table for course material adoptions.'
}

Table ipeds_data {
  unitid integer [pk]
  instnm varchar
  sector varchar [note: 'string descriptor, e.g., "Public, 4-year or above" — NOT a numeric code']
  iclevel varchar [note: 'string descriptor, e.g., "Four or more years"']
  control varchar [note: 'string descriptor, e.g., "Public", "Private not-for-profit"']
  instsize varchar [note: 'string descriptor, e.g., "20,000 and above"']
  enroll_24 integer [note: '2024 enrollment']
  dist_enroll_24 integer [note: '2024 distance enrollment']
  inst_type varchar

  Note: '~6K rows. Source: IPEDS_2024.csv. Institutional characteristics. sector/iclevel/control/instsize are STRING descriptors, not codes.'
}

Table opt_out {
  email varchar [pk]
  source varchar

  Note: 'BVA source: OptOut CSV. LEFT JOINed into comprehensive_data on cleaned email.'
}

Table panel {
  email varchar
  response_year varchar

  Note: 'BVA source-row mailing/panel history. Raw rows are retained; panel_email is the one-row-per-email enrichment lookup.'
}

Table panel_email {
  email varchar [pk]
  panel_response_year varchar
  panel_source_row_count bigint
  panel_response_year_variant_count bigint

  Note: 'Materialized by 0_setup.sql. One row per cleaned email, with latest response year and source multiplicity counts; prevents panel-history joins from multiplying comprehensive_data.'
}

Table format_type_classification {
  FormatType varchar [pk]
  is_oer boolean
  oer_category varchar [note: 'book_oer, ebook_oer, bundle_oer, courseware_oer, pure_oer, non_oer, etc.']
  is_ia boolean
  ia_category varchar [note: 'book_ia, ebook_ia, bundle_ia, courseware_ia, pure_ia, non_ia, etc.']

  Note: '69 rows. Source: format_type_lookup.tsv. Classifies FormatType into OER and IA categories.'
}

Table pricing_historical {
  unit_id integer
  institute varchar
  bookstore_url varchar
  pricing_date timestamp
  period varchar
  dept_code varchar
  dept_name varchar
  course_code varchar
  section_code varchar
  crn varchar
  instructor_name varchar
  isbn13 varchar
  title varchar
  author varchar
  publisher varchar
  edition varchar
  book_status varchar [note: 'lowercase: required, recommended, option, NULL']
  required boolean [note: 'source-derived during import: TRUE if book_status = "required"']
  book_option varchar [note: 'buy, rental']
  book_condition varchar [note: 'new, used, NULL']
  book_format varchar [note: 'physical, digital, NULL']
  price decimal(10,2)
  rental_days integer [note: '~95 distinct values (e.g., 90, 120, 180, 365, 1825). Part of natural grain.']
  return_date date
  course_id varchar [note: 'unit_id::dept_code::course_code']
  section_id varchar [note: 'unit_id::dept_code::course_code::section_code::period_sortable']
  period_sortable varchar
  period_date date

  indexes {
    section_id [name: 'idx_pricing_section']
    isbn13 [name: 'idx_pricing_isbn']
    period_sortable [name: 'idx_pricing_period']
  }

  Note: '~30M rows. BMG-owned raw pricing/cost snapshot in a compatibility-named table after import/dedupe. Latest pricing_date is retained at (section_id, isbn13, book_option, book_condition, book_format, rental_days), instructor names are aggregated, and indexes remain on section_id, isbn13, and period_sortable. Catalog classification is never written back.'
}

// ---------------------------------------------------------------------------
// IMPORT — Derived
// ---------------------------------------------------------------------------

Table supply_isbn_classification {
  isbn13 bigint [note: 'logical unique key; non-NULL classified ISBN from the catalog source']
  title varchar [note: 'representative matched catalog title']
  n_rows hugeint [note: '2024+ catalog rows covered by qualifying title variants']
  matched_pattern varchar [note: 'representative lowercase include-pattern match: specific rules before generic supply markers, then longest and lexical tie-breaks']
  category varchar [note: 'category associated with matched_pattern']

  indexes {
    isbn13 [name: 'idx_supply_isbn']
  }

  Note: 'Created by 1a_supply_classification.sql. One row per classified ISBN. A title variant qualifies when lowercase substring matching finds an include pattern and no exclude pattern; any qualifying 2024+ title variant can place the ISBN in this table. Attribution prefers specific rules over generic >supply</>suppy< fallbacks, then longest-pattern and stable lexical tie-breaks; this does not change Use/NoUse membership.'
}

Table state_region {
  state varchar [pk, note: '2-letter code (matches catalog/ipeds state)']
  region varchar [note: 'US Census region: Northeast, Midwest, South, West (+ Outlying Areas, Other)']
  division varchar [note: 'US Census division (9) + Outlying Areas / Other']

  Note: 'Static reference (0b_state_region.sql). Maps state -> Census region/division for geography filters (#10).'
}

Table pricing_wide {
  section_id varchar
  isbn13 varchar
  unit_id bigint [note: 'source provenance: MAX(unit_id) over the group (constant per source section)']
  required boolean [note: 'BOOL_OR(source-derived required) over the (section, isbn) group']
  institute varchar
  bookstore_url varchar
  title varchar
  author varchar
  publisher varchar
  edition varchar
  price_buy_new_physical decimal(10,2)
  price_buy_new_digital decimal(10,2)
  price_buy_new_na decimal(10,2)
  price_buy_used_physical decimal(10,2)
  price_buy_used_digital decimal(10,2)
  price_buy_used_na decimal(10,2)
  price_buy_na_physical decimal(10,2)
  price_buy_na_digital decimal(10,2)
  price_buy_na_na decimal(10,2)
  price_rental_new_physical decimal(10,2)
  price_rental_new_digital decimal(10,2)
  price_rental_new_na decimal(10,2)
  price_rental_used_physical decimal(10,2)
  price_rental_used_digital decimal(10,2)
  price_rental_used_na decimal(10,2)
  price_rental_na_physical decimal(10,2)
  price_rental_na_digital decimal(10,2)
  price_rental_na_na decimal(10,2)
  format_count bigint [note: 'COUNT(DISTINCT option × condition × format) FILTERed to buy/rental; counts offered tuples independently of price validity, so it can exceed the number of non-NULL pivot cells; max 18']
  has_buy boolean [note: 'BOOL_OR(book_option = buy) — a buy listing is offered (option presence, independent of price validity)']
  has_rent boolean [note: 'BOOL_OR(book_option = rental) — a rental listing is offered (≫ rental_days_min coverage, since many rentals lack a term)']
  price_min decimal(10,2)
  price_max decimal(10,2)
  price_avg double [note: 'LEGACY definition: (price_min + price_max) / 2 — NOT the arithmetic mean. See CLAUDE.md.']
  rental_days_min integer [note: 'shortest rental term offered for this (section, isbn)']
  rental_days_max integer [note: 'longest rental term offered (~95 distinct values, summarized as range)']
  price_buy_min decimal(10,2) [note: 'MIN buy-option price (owned; rentals excluded) — feeds owned cost']
  price_buy_max decimal(10,2) [note: 'MAX buy-option price (owned; rentals excluded)']
  Note: 'TABLE (materialized). One row per (section_id × isbn13) over all BMG-owned pricing_historical rows. Retains source/provenance descriptors and derives 18 option × condition × format price cells plus price/availability aggregates. price_buy_min/max feed the "owned" cost columns. It contains no is_required_inferred, OER/IA, or IPEDS/catalog enrichment, and no required-only pricing view is created.'
}

Table comprehensive_data {
  // -- course_catalog columns --
  ISBN13 bigint
  Title varchar
  Author varchar
  Publisher varchar
  Imprint varchar
  Format varchar
  FormatType varchar
  book_status varchar
  unit_id bigint
  school varchar
  state varchar
  dept_code varchar
  department varchar
  dept_description varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  period varchar
  enrollments integer
  seats_taken integer
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar
  course_id varchar
  section_id varchar
  period_sortable varchar
  period_date date
  // -- OER/IA classification --
  is_oer boolean
  oer_category varchar [note: 'defaults to "unknown" if no lookup match']
  is_ia boolean
  ia_category varchar [note: 'defaults to "unknown" if no lookup match']
  is_supply boolean [note: '#36: ISBN-level title-keyword supply flag (supply_isbn_classification); never NULL — unmatched/NULL-ISBN rows are FALSE']
  supply_category varchar [note: '#36: supply category of the matched keyword (science_lab, math_tech_clickers, ...); NULL when not a supply']
  // -- IPEDS institutional --
  institution_name varchar
  sector varchar [note: 'string descriptor — see ipeds_data']
  level varchar
  control varchar
  size varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  institution_type varchar
  // -- Panel / opt-out --
  panel_response_year varchar
  panel_source_row_count bigint [note: 'number of retained raw panel rows for this email']
  panel_response_year_variant_count bigint [note: 'number of distinct response years for this email']
  is_opted_out boolean
  opt_out_source varchar
  // -- Section-owned directness and row flags --
  is_required_direct boolean [note: 'this row is literal required and nonsupply; pre-2024 rows may be true']
  is_section_required_direct boolean [note: '2024+ section context from section_enrollment; NULL before 2024']
  section_course_id varchar
  section_control varchar
  section_level varchar
  section_sector varchar
  section_course_level varchar
  section_enrollments integer
  section_seats_taken integer
  section_has_enrollment boolean
  section_has_enrollment_own_seats boolean
  section_has_enrollment_sibling boolean
  section_has_enrollment_sibling_seats boolean
  section_enrollment_assigned integer
  section_enrollment_source varchar
  is_required_inferred boolean [note: '2024+ required/blank-status fallback using section directness']
  is_post_2024 boolean [note: 'period_date >= 2024-01-01; NULL dates are false']
  has_isbn boolean [note: 'Row has non-NULL ISBN13 (#20 retains false rows in the section spine)']
  has_formattype boolean [note: 'Row has nonblank FormatType']
  has_enrollment boolean [note: 'Row has non-NULL enrollments']
  has_enrollment_own_seats boolean [note: 'Row has non-NULL seats_taken below sentinel 9999']
  no_details boolean [note: 'Title exactly *No Book Details*']
  no_materials boolean [note: 'Title exactly *No Books Required* OR supply_category=placeholder_no_material']
  is_canada boolean [note: 'state = CAN']
  is_course_material_use boolean [note: '#58: post-2024, not Canada, has ISBN, not supply, not no_details, not no_materials']
  is_course_material_no_use boolean [note: '#58: post-2024 complement of is_course_material_use; both flags false pre-2024']

  Note: '102,885,609 rows after the validated #65 rebuild: exact one-to-one enrichment of the normalized BMG source rows. Master join and authoritative row-level population contract (#58). No lossy exclusion-reason field is stored because exclusion booleans can overlap.'
}


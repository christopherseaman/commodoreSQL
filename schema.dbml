// CommodoreSQL — Data Landscape
// Course catalog + institutional + pricing pipeline for OER/IA analysis
// Pipeline: IMPORT (CSV → tables) → EDA (views) → EXPORT (CSV) → Metabase (dashboards)

Project CommodoreSQL {
  database_type: 'DuckDB'
  Note: '''
    ## Metabase Questions (26) — see metabase/questions/
    - Analysis: 01-05 (is_required_inferred counts + OER/IA), 24-26 (materials cost + OER/IA section adoption)
    - Data quality: 06-12 (pricing), 13-18 (catalog), 19-23 (rental + null-ISBN)

    ## Metabase Dashboards (6)
    - filter_include_quality, oer_ia_status_filtered
    - data_quality_catalog, data_quality_pricing
    - course_materials_cost (24, 25), oer_ia_adoption (26, 05)
  '''
}

// ---------------------------------------------------------------------------
// SOURCE DATA FILES
// ---------------------------------------------------------------------------

// Database: duckdb/commodore.duckdb

Enum source_files {
  "data/2025.12.15/2025_12/DiscoveryExtract.20251215.csv" [note: '→ course_catalog_20251215 (~103M rows)']
  "data/2025.12.15/IPEDS_2024.csv" [note: '→ ipeds_data (~7K rows)']
  "data/2025.12.15/OptOut_20251215.csv" [note: '→ opt_out']
  "data/2025.12.15/panel_20260108.csv" [note: '→ panel']
  "data/2025.12.15/format_type_lookup.tsv" [note: '→ format_type_classification (69 rows)']
  "data/BookPricing.Historical_20260224.csv" [note: '→ pricing_historical (~30M rows)']
}

// ---------------------------------------------------------------------------
// IMPORT — Source Tables (CSV loads)
// ---------------------------------------------------------------------------

Table course_catalog_20251215 {
  ISBN13 varchar
  Title varchar
  Author varchar
  Publisher varchar
  Imprint varchar
  Format varchar
  FormatType varchar
  book_status varchar [note: 'lowercase: required, recommended, option, NULL']
  unit_id integer
  school varchar
  state varchar
  dept_code varchar
  department varchar
  dept_description varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  period varchar [note: 'e.g. "Fall 2024"']
  enrollments integer
  seats_taken integer
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar [note: 'cleaned/normalized from raw E-Mail']
  course_id varchar [note: 'unit_id::dept_code::course_number']
  section_id varchar [note: 'unit_id::dept_code::course_number::section::period_sortable — includes period so each section-offering is unique']
  period_sortable varchar [note: 'YYYY-N where 1=Winter 2=Spring 3=Summer 4=Fall']
  period_date date [note: 'canonical: 01-01, 04-01, 07-01, 10-01']

  indexes {
    email [name: 'idx_course_email']
    unit_id [name: 'idx_course_unitid']
    period_sortable [name: 'idx_course_period']
    course_id [name: 'idx_course_courseid']
    section_id [name: 'idx_course_sectionid']
  }

  Note: '~103M rows. Source: DiscoveryExtract CSV. Central fact table for course material adoptions.'
}

Table ipeds_data {
  unitid integer [pk]
  instnm varchar
  sector varchar [note: 'string descriptor, e.g., "Public, 4-year or above" — NOT a numeric code']
  iclevel varchar [note: 'string descriptor, e.g., "Four or more years"']
  control varchar [note: 'string descriptor, e.g., "Public", "Private not-for-profit"']
  instsize varchar [note: 'string descriptor, e.g., "20,000 and above"']
  enroll_24 integer [note: '2024 enrollment']
  dist_enroll_24 integer [note: '2024 distance enrollment']
  inst_type varchar

  Note: '~6K rows. Source: IPEDS_2024.csv. Institutional characteristics. sector/iclevel/control/instsize are STRING descriptors, not codes.'
}

Table opt_out {
  email varchar [pk]
  source varchar

  Note: 'Source: OptOut CSV. LEFT JOINed into comprehensive_data on email.'
}

Table panel {
  email varchar [pk]
  response_year varchar

  Note: 'Source: panel CSV. LEFT JOINed into comprehensive_data on email.'
}

Table format_type_classification {
  FormatType varchar [pk]
  is_oer boolean
  oer_category varchar [note: 'book_oer, ebook_oer, bundle_oer, courseware_oer, pure_oer, non_oer, etc.']
  is_ia boolean
  ia_category varchar [note: 'book_ia, ebook_ia, bundle_ia, courseware_ia, pure_ia, non_ia, etc.']

  Note: '69 rows. Source: format_type_lookup.tsv. Classifies FormatType into OER and IA categories.'
}

Table pricing_historical {
  unit_id integer
  institute varchar
  bookstore_url varchar
  pricing_date timestamp
  period varchar
  dept_code varchar
  dept_name varchar
  course_code varchar
  section_code varchar
  crn varchar
  instructor_name varchar
  isbn13 varchar
  title varchar
  author varchar
  publisher varchar
  edition varchar
  book_status varchar [note: 'lowercase: required, recommended, option, NULL']
  required boolean [note: 'TRUE if book_status = "required"']
  is_oer boolean [note: 'BOOL_OR(is_oer) from comprehensive_data join on (section_id, isbn13); added by 2b_pricing_oer_ia']
  is_ia boolean [note: 'BOOL_OR(is_ia) from comprehensive_data join on (section_id, isbn13); added by 2b_pricing_oer_ia']
  book_option varchar [note: 'buy, rental']
  book_condition varchar [note: 'new, used, NULL']
  book_format varchar [note: 'physical, digital, NULL']
  price decimal
  rental_days integer [note: '~95 distinct values (e.g., 90, 120, 180, 365, 1825). Part of natural grain.']
  return_date date
  course_id varchar [note: 'unit_id::dept_code::course_code']
  section_id varchar [note: 'unit_id::dept_code::course_code::section_code::period_sortable']
  period_sortable varchar
  period_date date
  is_required_inferred boolean [note: 'added by 1b_section_filter; TRUE = period>=2024 AND status matches has_required logic']

  indexes {
    section_id [name: 'idx_pricing_section']
    isbn13 [name: 'idx_pricing_isbn']
    period_sortable [name: 'idx_pricing_period']
  }

  Note: '~30M rows. Source: Bookprices CSV. Natural grain: (section_id, isbn13, book_option, book_condition, book_format, rental_days). Some residual source-data dupes; pricing_wide aggregations tolerate them.'
}

// ---------------------------------------------------------------------------
// IMPORT — Derived
// ---------------------------------------------------------------------------

Table section_book_status {
  section_id varchar [pk]
  has_required boolean [note: '#40 supply-aware: TRUE if section has any required-status NON-SUPPLY material (BOOL_OR(book_status=required AND NOT is_supply)). A supply-only required item no longer forces TRUE, so a co-listed blank-status real textbook keeps the required fallback.']

  indexes {
    section_id [name: 'idx_sbs_section']
  }

  Note: 'One row per section_id. Drives is_required_inferred logic for pricing and comprehensive_data. has_required is supply-aware (#40); built in 1a_/1b_ after supply_isbn_classification.'
}

Table state_region {
  state varchar [pk, note: '2-letter code (matches catalog/ipeds state)']
  region varchar [note: 'US Census region: Northeast, Midwest, South, West (+ Outlying Areas, Other)']
  division varchar [note: 'US Census division (9) + Outlying Areas / Other']

  Note: 'Static reference (0b_state_region.sql). Maps state -> Census region/division for geography filters (#10).'
}

Table pricing_wide {
  section_id varchar
  isbn13 varchar
  unit_id bigint [note: 'MAX(unit_id) over the group (constant per section)']
  required boolean [note: 'BOOL_OR(required) over the (section, isbn) group']
  is_required_inferred boolean [note: 'BOOL_OR(is_required_inferred); TRUE = required + in-scope (period>=2024). pricing_wide_filtered is this subset.']
  is_oer boolean [note: 'BOOL_OR(is_oer) over the group; sourced from pricing_historical.is_oer']
  is_ia boolean [note: 'BOOL_OR(is_ia) over the group; sourced from pricing_historical.is_ia']
  institute varchar
  bookstore_url varchar
  title varchar
  author varchar
  publisher varchar
  edition varchar
  price_buy_new_physical decimal
  price_buy_new_digital decimal
  price_buy_new_na decimal
  price_buy_used_physical decimal
  price_buy_used_digital decimal
  price_buy_used_na decimal
  price_buy_na_physical decimal
  price_buy_na_digital decimal
  price_buy_na_na decimal
  price_rental_new_physical decimal
  price_rental_new_digital decimal
  price_rental_new_na decimal
  price_rental_used_physical decimal
  price_rental_used_digital decimal
  price_rental_used_na decimal
  price_rental_na_physical decimal
  price_rental_na_digital decimal
  price_rental_na_na decimal
  format_count bigint [note: 'COUNT(DISTINCT option × condition × format) FILTERed to buy/rental — equals non-null pivot cells, max 18']
  has_buy boolean [note: 'BOOL_OR(book_option = buy) — a buy listing is offered (option presence, independent of price validity)']
  has_rent boolean [note: 'BOOL_OR(book_option = rental) — a rental listing is offered (≫ rental_days_min coverage, since many rentals lack a term)']
  price_min decimal
  price_max decimal
  price_avg double [note: 'LEGACY definition: (price_min + price_max) / 2 — NOT the arithmetic mean. See CLAUDE.md.']
  rental_days_min integer [note: 'shortest rental term offered for this (section, isbn)']
  rental_days_max integer [note: 'longest rental term offered (~95 distinct values, summarized as range)']
  price_buy_min decimal [note: 'MIN buy-option price (owned; rentals excluded) — feeds owned cost']
  price_buy_max decimal [note: 'MAX buy-option price (owned; rentals excluded)']
  // -- institution enrichment (ANY_VALUE per unit_id from comprehensive_data; mirrors master_section) --
  state varchar
  control varchar
  level varchar
  size varchar
  sector varchar
  institution_name varchar
  institution_type varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer

  Note: 'TABLE (materialized). One row per (section_id × isbn13) over ALL pricing_historical (no filter). 18 price columns = option × condition × format. price_buy_min/max feed the "owned" cost columns. is_oer/is_ia and institution fields are reverse-enrichment retained temporarily for compatibility and raw pricing DQ; canonical catalog ownership is comprehensive_data → material_costs. pricing_wide_filtered is the is_required_inferred=TRUE subset.'
}

Table pricing_wide_filtered [note: 'view'] {
  Note: 'View: SELECT * FROM pricing_wide WHERE is_required_inferred — the required, in-scope (period>=2024) subset. Preserves the prior pricing_wide semantics for downstream consumers. Same columns as pricing_wide.'
}

Table comprehensive_data {
  // -- course_catalog columns --
  ISBN13 varchar
  Title varchar
  Author varchar
  Publisher varchar
  Imprint varchar
  Format varchar
  FormatType varchar
  book_status varchar
  unit_id integer
  school varchar
  state varchar
  dept_code varchar
  department varchar
  dept_description varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  period varchar
  enrollments integer
  seats_taken integer
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar
  course_id varchar
  section_id varchar
  period_sortable varchar
  period_date date
  // -- OER/IA classification --
  is_oer boolean
  oer_category varchar [note: 'defaults to "unknown" if no lookup match']
  is_ia boolean
  ia_category varchar [note: 'defaults to "unknown" if no lookup match']
  is_supply boolean [note: '#36: ISBN-level title-keyword supply flag (supply_isbn_classification); never NULL — unmatched/NULL-ISBN rows are FALSE']
  supply_category varchar [note: '#36: supply category of the matched keyword (science_lab, math_tech_clickers, ...); NULL when not a supply']
  // -- IPEDS institutional --
  institution_name varchar
  sector varchar [note: 'string descriptor — see ipeds_data']
  level varchar
  control varchar
  size varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  institution_type varchar
  // -- Panel / opt-out --
  panel_response_year varchar
  is_opted_out boolean
  opt_out_source varchar
  // -- Filter --
  is_required_inferred boolean [note: 'period>=2024 AND book_status matches has_required logic']
  is_post_2024 boolean [note: 'period_date >= 2024-01-01; NULL dates are false']
  has_isbn boolean [note: 'Row has non-NULL ISBN13 (#20 retains false rows in the section spine)']
  has_formattype boolean [note: 'Row has nonblank FormatType']
  has_enrollment boolean [note: 'Row has non-NULL enrollments']
  has_enrollment_own_seats boolean [note: 'Row has non-NULL seats_taken below sentinel 9999']
  no_details boolean [note: 'Title exactly *No Book Details*']
  no_materials boolean [note: 'Title exactly *No Books Required* OR supply_category=placeholder_no_material']
  is_canada boolean [note: 'state = CAN']
  is_course_material_use boolean [note: '#58: post-2024, not Canada, has ISBN, not supply, not no_details, not no_materials']
  is_course_material_no_use boolean [note: '#58: post-2024 complement of is_course_material_use; both flags false pre-2024']

  Note: '~103M rows. Master join and authoritative row-level population contract (#58). No lossy exclusion-reason field is stored because exclusion booleans can overlap.'
}

Table course_materials_post_2024 [note: 'view'] {
  Note: 'comprehensive_data WHERE is_post_2024; same columns as comprehensive_data.'
}

Table course_materials_use [note: 'view'] {
  Note: 'comprehensive_data WHERE is_course_material_use; canonical material/pricing population.'
}

Table course_materials_no_use [note: 'view'] {
  Note: 'comprehensive_data WHERE is_course_material_no_use; exact post-2024 complement of Use.'
}

Table course_materials_canada [note: 'view'] {
  Note: 'Post-2024 comprehensive_data rows WHERE is_canada; subset of course_materials_no_use.'
}

Table section_enrollment {
  section_id varchar [pk, note: 'period-specific section key; period_sortable is embedded in the key']
  course_id varchar
  period_sortable varchar [note: 'YYYY-N']
  control varchar [note: 'section-canonical scope dimension reused by material_costs']
  level varchar [note: 'section-canonical scope dimension reused by material_costs']
  sector varchar [note: 'section-canonical scope dimension reused by material_costs']
  course_level varchar [note: 'section mode; reused by material_costs for section-scope consistency']
  enrollments integer [note: 'raw catalog enrollment; never overwritten']
  seats_taken integer [note: 'raw catalog seats; 9999 is invalid']
  has_enrollment boolean
  has_enrollment_sibling boolean
  has_enrollment_own_seats boolean
  has_enrollment_sibling_seats boolean
  enrollment_assigned integer [note: 'Exact section enrollment after the documented own/seats/sibling/median hierarchy; NULL only when no rung is available']
  enrollment_source varchar [note: 'own | own_seats | sibling_enroll | sibling_seats | class_median | level_median | none']

  Note: 'Materialized one row per (period_sortable, section_id). Owns authoritative raw enrollment/flags, section-scope dimensions, and the assigned-enrollment value/provenance; master_section and material_costs consume it while retaining their respective grains.'
}

// ---------------------------------------------------------------------------
// EDA — Mailing List Views (3_mailing_lists.sql)
// ---------------------------------------------------------------------------

Table master_mailing [note: 'view'] {
  unit_id integer
  school varchar
  state varchar
  department varchar
  course_level varchar
  course_subject varchar
  period varchar
  period_sortable varchar
  period_date date
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar

  Note: 'DISTINCT ON (email). Excludes opted-out. Most recent period per instructor.'
}

Table current_mailing [note: 'view'] {
  unit_id integer
  school varchar
  state varchar
  department varchar
  course_level varchar
  course_subject varchar
  period varchar
  period_sortable varchar
  period_date date
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar
  panel_response_year varchar

  Note: 'master_mailing filtered to last 12 periods, with panel data joined.'
}

Table current_mailing_ca [note: 'view'] {
  email varchar
  Note: 'current_mailing WHERE state = "CA". Same columns as current_mailing.'
}

Table current_mailing_tx [note: 'view'] {
  email varchar
  Note: 'current_mailing WHERE state = "TX". Same columns as current_mailing.'
}

Table current_mailing_fl [note: 'view'] {
  email varchar
  Note: 'current_mailing WHERE state = "FL". Same columns as current_mailing.'
}

Table current_mailing_ny [note: 'view'] {
  email varchar
  Note: 'current_mailing WHERE state = "NY". Same columns as current_mailing.'
}

Table current_mailing_other [note: 'view'] {
  email varchar
  Note: 'current_mailing WHERE state NOT IN (CA, TX, FL, NY). Same columns as current_mailing.'
}

// ---------------------------------------------------------------------------
// EDA — Aggregated Record Views (4_merged_records.sql)
// ---------------------------------------------------------------------------

Table material_costs {
  isbn13 bigint [pk, note: 'non-NULL catalog ISBN13; part of the canonical material key']
  book_title varchar [note: 'catalog-owned; sourced from comprehensive_data, never copied from pricing_wide']
  author varchar [note: 'catalog-owned; sourced from comprehensive_data, never copied from pricing_wide']
  publisher varchar [note: 'catalog-owned; sourced from comprehensive_data, never copied from pricing_wide']
  imprint varchar [note: 'catalog-owned']
  book_format varchar [note: 'catalog-owned Format value']
  format_type varchar [note: 'catalog-owned FormatType classification input']
  book_status varchar [note: 'catalog-owned raw status']
  isbn_book_title varchar [note: 'term/ISBN lexical-min title used by the downstream Master ISBN compatibility contract']
  isbn_author varchar [note: 'term/ISBN lexical-min author used by the downstream Master ISBN compatibility contract']
  isbn_publisher varchar [note: 'term/ISBN lexical-min publisher used by the downstream Master ISBN compatibility contract']
  isbn_title_variant_count bigint [note: 'term/ISBN distinct nonblank source-title count']
  isbn_author_variant_count bigint [note: 'term/ISBN distinct nonblank source-author count']
  isbn_publisher_variant_count bigint [note: 'term/ISBN distinct nonblank source-publisher count']
  unit_id bigint
  school varchar
  state varchar
  dept_code varchar
  department varchar
  dept_description varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  period varchar
  enrollments integer
  seats_taken integer
  instructor varchar
  first_name varchar
  last_name varchar
  email varchar
  course_id varchar
  section_id varchar [pk, note: 'period-specific section key; part of the canonical material key']
  period_sortable varchar [pk, note: 'YYYY-N; part of the canonical material key']
  period_date date
  is_required_inferred boolean [note: 'catalog-owned canonical required inference']
  is_oer boolean [note: 'catalog-owned definitive BOOL_OR over Use catalog rows']
  oer_category varchar
  is_ia boolean [note: 'catalog-owned definitive BOOL_OR over Use catalog rows']
  ia_category varchar
  is_supply boolean [note: 'always false in canonical Use population; retained for audit contract']
  supply_category varchar
  institution_name varchar
  sector varchar
  level varchar
  control varchar
  size varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  institution_type varchar
  panel_response_year varchar
  is_opted_out boolean
  opt_out_source varchar
  is_post_2024 boolean
  has_isbn boolean
  has_formattype boolean
  has_enrollment boolean
  has_enrollment_own_seats boolean
  no_details boolean
  no_materials boolean
  is_canada boolean
  is_course_material_use boolean
  is_course_material_no_use boolean
  has_enrollment_sibling boolean
  has_enrollment_sibling_seats boolean
  enrollment_assigned integer
  enrollment_source varchar
  has_book_status_required boolean
  has_book_status_optional_recommended boolean
  source_row_count bigint [note: 'source catalog rows collapsed into this section-term-ISBN item']
  title_variant_count bigint [note: 'distinct nonblank catalog title values; conflict signal']
  author_variant_count bigint [note: 'distinct nonblank catalog author values; conflict signal']
  publisher_variant_count bigint [note: 'distinct nonblank catalog publisher values; conflict signal']
  imprint_variant_count bigint [note: 'distinct nonblank catalog Imprint values; conflict signal']
  book_format_variant_count bigint [note: 'distinct catalog Format values; conflict signal']
  format_type_variant_count bigint [note: 'distinct catalog FormatType values; conflict signal']
  book_status_variant_count bigint [note: 'distinct catalog status values; conflict signal']
  catalog_metadata_conflict boolean [note: 'TRUE when any catalog metadata variant count exceeds one']
  is_required_inferred_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  is_oer_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  is_ia_conflict boolean [note: 'BOOL_OR vs BOOL_AND disagreement DQ signal']
  bookstore_url varchar [note: 'pricing-owned enrichment from pricing_wide; NULL when no pricing match']
  price_buy_new_physical decimal
  price_buy_new_digital decimal
  price_buy_new_na decimal
  price_buy_used_physical decimal
  price_buy_used_digital decimal
  price_buy_used_na decimal
  price_buy_na_physical decimal
  price_buy_na_digital decimal
  price_buy_na_na decimal
  price_rental_new_physical decimal
  price_rental_new_digital decimal
  price_rental_new_na decimal
  price_rental_used_physical decimal
  price_rental_used_digital decimal
  price_rental_used_na decimal
  price_rental_na_physical decimal
  price_rental_na_digital decimal
  price_rental_na_na decimal
  format_count bigint [note: 'non-NULL wide price cells, maximum 18']
  has_buy boolean
  has_rent boolean
  price_min decimal
  price_max decimal
  price_avg double [note: 'LEGACY midpoint (price_min + price_max) / 2; not arithmetic mean']
  rental_days_min integer
  rental_days_max integer
  price_buy_min decimal
  price_buy_max decimal
  has_pricing_match boolean [note: 'TRUE when the LEFT pricing_wide join found a section/ISBN row; independent of whether that row has a valid price_min']

  Note: 'TABLE (materialized). One row per (period_sortable, section_id, isbn13) canonical Use item. Built from comprehensive_data and LEFT-enriched from pricing_wide, so items without usable prices remain. Catalog attributes are never sourced from reverse-enriched pricing fields. Expected current baseline: 12,806,060 rows; 7,476,130 pricing-row matches; 5,329,930 without a pricing-row match; 5,329,933 with NULL price_min.'
}

Table section_cost {
  section_id varchar [pk]
  course_id varchar
  period_sortable varchar
  required_cost_total_min decimal
  required_cost_total_max decimal
  optional_cost_total_min decimal
  optional_cost_total_max decimal
  required_cost_owned_min decimal
  required_cost_owned_max decimal
  optional_cost_owned_min decimal
  optional_cost_owned_max decimal
  required_priced_count integer
  optional_priced_count integer

  Note: 'TABLE. One row per section_id represented by the #58 Use material spine. Consumes material_costs and aggregates DISTINCT section-term-ISBN items, required vs non-required via is_required_inferred. owned = buy-only. Feeds the full-spine master_section by LEFT JOIN and master_course cost rollup; it is not the approved item-level input.'
}

Table master_section [note: 'table'] {
  section_id varchar
  course_id varchar
  period varchar
  period_sortable varchar
  period_date date
  // -- institution enrichment (ANY_VALUE; constant per unit_id -> per section_id) --
  unit_id bigint
  state varchar
  control varchar
  level varchar
  size varchar
  sector varchar
  institution_name varchar
  institution_type varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  school varchar
  department varchar
  course_number varchar
  section varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  material_count integer [note: '#58: COUNT FILTER(is_course_material_use)']
  required_count integer [note: 'COUNT FILTER(is_required_inferred AND is_course_material_use); A/B split key']
  optional_count integer [note: 'COUNT FILTER(NOT is_required_inferred AND is_course_material_use)']
  has_course_material_use boolean [note: 'Section has at least one canonical Use row']
  course_material_use_count integer [note: 'Use catalog rows; equals material_count']
  course_material_no_use_count integer [note: 'NoUse catalog rows retained for audit']
  no_details_count integer [note: 'Rows with no_details, independent/overlapping exclusion audit']
  no_materials_count integer [note: 'Rows with no_materials, independent/overlapping exclusion audit']
  is_canada boolean [note: 'BOOL_OR(row is_canada); Canadian material rows are NoUse']
  is_supply boolean [note: '#36: COALESCE(BOOL_OR(is_supply), FALSE) — section carries >=1 supply item. is_supply <=> supply_count > 0']
  supply_count integer [note: '#36: COUNT FILTER(is_supply) — supply items on the section (excluded from material_count)']
  is_oer boolean [note: 'COALESCE(BOOL_OR(is_oer), FALSE) over canonical Use materials']
  is_ia boolean
  oer_count integer
  ia_count integer
  publishers varchar [note: 'LIST(DISTINCT publisher)']
  required_publishers varchar [note: 'LIST(DISTINCT publisher) WHERE required']
  required_publisher_count integer
  optional_publisher_count integer
  enrollments integer
  seats_taken integer
  // -- coverage (2026-06-04 notes): ISBN presence + OER/IA classifiability --
  has_isbn boolean [note: 'BOOL_OR(ISBN13 IS NOT NULL) over section materials']
  has_formattype boolean [note: 'BOOL_OR(FormatType present) — the OER/IA classifiability flag (is_oer/is_ia are NULL exactly when FormatType is absent)']
  isbn_count integer [note: 'materials with an ISBN']
  classified_count integer [note: 'materials carrying a FormatType']
  // -- enrollment fill-potential flags (diagnostic availability; raw enrollment is NOT imputed).
  //    has_enrollment_* are pure facts (decoupled from has_enrollment); assess a missing
  //    section via NOT has_enrollment AND has_enrollment_*. #32 adds the numeric fill below. --
  has_enrollment boolean [note: 'section carries its own enrollment']
  has_enrollment_sibling boolean [note: 'another section of the same course+period has enrollment']
  has_enrollment_own_seats boolean [note: 'this section has usable seats_taken (<9999)']
  has_enrollment_sibling_seats boolean [note: 'a sibling section has usable seats_taken']
  // -- enrollment fill (#32): persisted numeric imputation + provenance. Raw enrollments
  //    is never overwritten; enrollment_assigned is the filled value. Medians per period
  //    over the reference population (4 BMG course levels x 6 teaching sectors). --
  enrollment_assigned integer [note: '#32: filled enrollment. own -> own_seats(<9999) -> sibling_enroll -> sibling_seats -> class_median(control x level) -> level_median. NULL only when enrollment_source=none']
  enrollment_source varchar [note: '#32: which fill rung supplied enrollment_assigned: own | own_seats | sibling_enroll | sibling_seats | class_median | level_median | none']
  required_cost_total_min decimal [note: 'SUM of per-material price_min over distinct required materials (from section_cost)']
  required_cost_total_max decimal
  optional_cost_total_min decimal
  optional_cost_total_max decimal
  required_cost_owned_min decimal [note: 'buy-only (rentals excluded)']
  required_cost_owned_max decimal
  optional_cost_owned_min decimal
  optional_cost_owned_max decimal
  required_cost_avg decimal [note: '(min+max)/2 — legacy price_avg convention, NOT arithmetic mean']
  required_cost_owned_avg decimal
  optional_cost_avg decimal
  required_priced_count integer [note: 'distinct required materials with ANY price (total coverage; NOT owned-only — can be >0 while owned cost is NULL when priced materials are rental-only)']
  optional_priced_count integer

  Note: 'TABLE (materialized). One row per valid section_id (2024+) over the full section spine—not a Use-only row filter. Material/OER/coverage/publisher fields use canonical Use rows from comprehensive_data; all price/cost fields roll from material_costs via section_cost. Supply, NoUse, Canada, and placeholder audits retain source rows. Section/enrollment denominators remain full-spine; assigned enrollment is consumed from section_enrollment. MASTER-SECTION-DICTIONARY.md is the complete release-column contract.'
}

Table master_course [note: 'view'] {
  course_id varchar
  period varchar
  period_sortable varchar
  period_date date
  // -- institution enrichment (ANY_VALUE; constant per unit_id -> per course) --
  unit_id bigint
  state varchar
  control varchar
  level varchar
  size varchar
  sector varchar
  institution_name varchar
  institution_type varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  school varchar
  department varchar
  course_number varchar
  course_title varchar
  course_level varchar
  course_subject varchar
  section_count integer
  enrollment_total integer
  seats_taken_total integer
  total_materials integer
  total_required integer
  total_optional integer
  is_oer boolean [note: 'BOOL_OR across the course sections']
  is_ia boolean
  oer_count integer [note: 'SUM of section oer_count']
  ia_count integer
  has_isbn boolean [note: 'BOOL_OR across course sections']
  has_formattype boolean
  isbn_count integer [note: 'SUM of section isbn_count']
  classified_count integer [note: 'SUM of section classified_count']
  has_enrollment_sections integer [note: 'count of the course''s sections with own enrollment (of section_count)']
  has_enrollment_sibling_sections integer [note: 'sections with a sibling carrying enrollment']
  has_enrollment_own_seats_sections integer [note: 'sections with usable own seats_taken']
  has_enrollment_sibling_seats_sections integer [note: 'sections with a sibling carrying usable seats_taken']
  required_cost_total_min decimal [note: 'MIN(min) across sections — cost rolls up MIN/MAX/AVG, NOT SUM (sections share materials)']
  required_cost_total_max decimal
  optional_cost_total_min decimal
  optional_cost_total_max decimal
  required_cost_owned_min decimal
  required_cost_owned_max decimal
  optional_cost_owned_min decimal
  optional_cost_owned_max decimal
  required_cost_avg decimal [note: 'AVG of section (min+max)/2']
  required_cost_owned_avg decimal
  optional_cost_avg decimal
  all_publishers varchar [note: 'nested LIST of publisher arrays']
  unique_required_publishers integer

  Note: 'One row per course-offering (2024+, rolled up from master_section). Cost rolled up from the material_costs path through section_cost via MIN/MAX/AVG.'
}

Table master_course_material [note: 'view'] {
  course_id varchar
  period varchar
  period_sortable varchar
  period_date date
  school varchar
  department varchar
  course_number varchar
  course_title varchar
  publisher varchar
  book_status varchar
  material_instances integer
  sections_using integer
  total_seats_affected integer

  Note: 'One row per (course_id × period × publisher × book_status). Material distribution over the canonical #58 Use population, consistent with master_section counts.'
}

Table master_section_us_intro_fall2025 [note: 'view'] {
  Note: 'BMG #38. Filtered projection of master_section (NO new columns, same schema): period_sortable=2025-4, required_count>=1 under the canonical #58 Use contract, course_level in {Introductory or general undergraduate, Intermediate undergraduate}, US only (state excludes CAN + blank). 773,613 sections after the #58 rebuild. Enrichment stays on master_section; this view only projects/filters.'
}

Table master_institution {
  period_sortable varchar [note: 'YYYY-N; part of canonical key']
  unit_id bigint [note: 'IPEDS institution identifier; NULL is one explicit unknown-institution bucket per term']
  state varchar
  control varchar
  level varchar
  size varchar
  institution_name varchar
  institution_type varchar
  enrollment_2024 integer
  distance_enrollment_2024 integer
  bookstore_url varchar [note: 'Most frequent nonblank URL from all same-term pricing_wide rows; lexical tie-break. This institution-level metadata exception remains a compatibility path.']
  section_count bigint
  advanced_graduate_section_count bigint
  advanced_graduate_directed_study_and_research_section_count bigint
  advanced_undergraduate_section_count bigint
  advanced_undergraduate_graduate_section_count bigint
  general_graduate_section_count bigint
  intermediate_undergraduate_section_count bigint
  introductory_or_general_undergraduate_section_count bigint
  non_degree_credit_section_count bigint
  uncategorized_section_count bigint
  course_count bigint
  material_section_count bigint [note: 'Sections with at least one canonical Use material']
  required_section_count bigint [note: 'Sections with supply-aware raw section_book_status.has_required over the full section spine']
  inferred_required_section_count bigint [note: 'Sections with master_section.required_count > 0']
  optional_section_count bigint
  supply_section_count bigint
  oer_section_count bigint
  ia_section_count bigint
  required_priced_section_count bigint
  optional_priced_section_count bigint
  isbn_section_count bigint
  enrollment_section_count bigint [note: 'Sections with enrollment_assigned']
  seats_taken_section_count bigint [note: 'Sections with non-NULL seats_taken below sentinel 9999']
  enrollments_tot hugeint [note: 'SUM(enrollment_assigned)']
  seats_taken_tot hugeint [note: 'SUM(valid seats_taken)']

  Note: 'Issue #54/#58. One row per term × institution key over the full 2024+ master_section spine. Section/enrollment and supply audit denominators remain full; material/pricing metrics are Use-derived.'
}

Table master_isbn {
  period_sortable varchar [note: 'YYYY-N; part of canonical key']
  isbn13 bigint [note: 'Non-NULL ISBN; part of canonical key']
  book_title varchar [note: 'Lexical MIN of trimmed nonblank catalog values']
  author varchar [note: 'Lexical MIN of trimmed nonblank catalog values']
  publisher varchar [note: 'Lexical MIN of trimmed nonblank catalog values']
  is_oer boolean [note: 'Definitive BOOL_OR across catalog rows']
  is_ia boolean [note: 'Definitive BOOL_OR across catalog rows']
  is_supply boolean [note: 'Always false in the canonical Use population']
  unit_id_count bigint
  section_id_count bigint
  course_id_count bigint
  has_enrollment boolean
  enroll_cnt bigint [note: 'Distinct sections with enrollment_assigned']
  enroll_tot hugeint [note: 'SUM(enrollment_assigned) over the distinct section × ISBN spine']
  title_variant_count bigint
  author_variant_count bigint
  publisher_variant_count bigint
  metadata_conflict boolean [note: 'True when any metadata variant count exceeds one']
  price_buy_new_physical_count bigint
  price_buy_new_digital_count bigint
  price_buy_new_na_count bigint
  price_buy_used_physical_count bigint
  price_buy_used_digital_count bigint
  price_buy_used_na_count bigint
  price_buy_na_physical_count bigint
  price_buy_na_digital_count bigint
  price_buy_na_na_count bigint
  price_rental_new_physical_count bigint
  price_rental_new_digital_count bigint
  price_rental_new_na_count bigint
  price_rental_used_physical_count bigint
  price_rental_used_digital_count bigint
  price_rental_used_na_count bigint
  price_rental_na_physical_count bigint
  price_rental_na_digital_count bigint
  price_rental_na_na_count bigint
  institution_type_2_year_private_profit_count bigint
  institution_type_2_year_private_count bigint
  institution_type_2_year_public_count bigint
  institution_type_4_year_private_profit_count bigint
  institution_type_4_year_private_count bigint
  institution_type_4_year_public_count bigint
  institution_type_under_2_year_public_count bigint
  institution_type_unknown_count bigint

  Note: 'Issue #55/#58. One row per term × ISBN consumed from material_costs; Canada, blank ISBN, supply, no-details, and no-material rows are excluded. Pseudo-SKU access codes remain eligible unless classified supply. Price counts are distinct sections with non-NULL material_costs cells.'
}

Table sample10_section_ids {
  section_id varchar [note: 'Canonical sampling unit; one selected row per master_section key']
  period_sortable varchar
  section_hash ubigint [note: 'First 64 bits of MD5(section_id), interpreted unsigned']
  sample_bucket utinyint [note: 'section_hash modulo 10; always 0 in this membership table']

  Note: 'Issue #53. Deterministic md5-prefix64-mod10-v1 membership table. All sampled stages join this table so whole section clusters and identical membership are preserved.'
}

// ---------------------------------------------------------------------------
// RELATIONSHIPS — Join Keys
// Only true many-to-one refs where the referenced column is unique/PK
// ---------------------------------------------------------------------------

// catalog → dimension/lookup tables (referenced col is PK)
Ref: course_catalog_20251215.FormatType > format_type_classification.FormatType
Ref: course_catalog_20251215.unit_id > ipeds_data.unitid
Ref: course_catalog_20251215.section_id > section_book_status.section_id

// comprehensive_data → dimension/lookup tables
Ref: comprehensive_data.FormatType > format_type_classification.FormatType
Ref: comprehensive_data.unit_id > ipeds_data.unitid
Ref: comprehensive_data.section_id > section_book_status.section_id
Ref: comprehensive_data.email > opt_out.email
Ref: comprehensive_data.email > panel.email

// pricing → section filter (section_id is PK in section_book_status)
Ref: pricing_historical.section_id > section_book_status.section_id

// mailing list chain (email is unique via DISTINCT ON)
Ref: current_mailing.email > master_mailing.email
Ref: current_mailing_ca.email > current_mailing.email
Ref: current_mailing_tx.email > current_mailing.email
Ref: current_mailing_fl.email > current_mailing.email
Ref: current_mailing_ny.email > current_mailing.email
Ref: current_mailing_other.email > current_mailing.email

// pricing view → section filter
Ref: pricing_wide.section_id > section_book_status.section_id

// canonical material-cost path (composite material keys are documented in table notes)
// material_costs is built from comprehensive_data and LEFT-enriched by pricing_wide;
// section_cost and master_isbn consume material_costs.
Ref: section_enrollment.section_id > section_book_status.section_id
Ref: material_costs.section_id > section_book_status.section_id

// aggregated views
Ref: master_section.section_id > section_book_status.section_id
Ref: master_section.(course_id, period_sortable) > master_course.(course_id, period_sortable)
Ref: master_course_material.(course_id, period_sortable) > master_course.(course_id, period_sortable)

// ---------------------------------------------------------------------------
// TABLE GROUPS — Pipeline Stages
// ---------------------------------------------------------------------------

TableGroup import_sources {
  course_catalog_20251215
  ipeds_data
  opt_out
  panel
  format_type_classification
  pricing_historical
}

TableGroup import_derived {
  section_book_status
  state_region
  pricing_wide
  pricing_wide_filtered
  comprehensive_data
  course_materials_post_2024
  course_materials_use
  course_materials_no_use
  course_materials_canada
}

TableGroup eda_mailing {
  master_mailing
  current_mailing
  current_mailing_ca
  current_mailing_tx
  current_mailing_fl
  current_mailing_ny
  current_mailing_other
}

TableGroup eda_records {
  section_enrollment
  material_costs
  section_cost
  master_section
  master_course
  master_course_material
  master_institution
  master_isbn
  sample10_section_ids
}

// ---------------------------------------------------------------------------
// DATA QUALITY — populated by 2d_data_quality.sql; surface for BI dashboards.
// Recreated each pipeline run (snapshot of latest state).
// ---------------------------------------------------------------------------

Table __data_quality_metrics {
  category varchar [note: 'catalog | pricing | wide | oer_ia | cross_table']
  check_id varchar [note: 'short identifier, e.g., dedupe_stages, price_outliers']
  metric_name varchar
  metric_value bigint

  Note: 'Long-format scalar metrics. Recreated on each pipeline run.'
}

Table __data_quality_top_unmatched_ipeds_schools {
  school varchar
  unit_id integer
  catalog_rows bigint

  Note: 'Top 10 catalog schools whose unit_id is not in IPEDS_2024.csv.'
}

Table __data_quality_null_isbn_breakdown {
  school varchar
  no_book_details bigint [note: 'Title = "*No Book Details*" — non-classroom (research, dissertation, independent study)']
  no_books_required bigint [note: 'Title = "*No Books Required*" — explicit "no textbook required" marker']
  bad_course bigint [note: 'Title = "*Bad Course*" — explicit DQ flag from source']
  other bigint [note: 'Should be 0; nonzero would indicate a new placeholder string in source']
  total_null_isbn bigint

  Note: 'Top 20 schools by NULL ISBN, split by placeholder type. Globally only 3 placeholder strings exist; there are NO genuinely-missing null-ISBN rows.'
}

Table __data_quality_top_null_isbn_schools {
  school varchar
  null_isbn_rows bigint
  non_null_isbn_rows bigint
  total_rows bigint
  null_pct double
  distinct_sections bigint

  Note: 'Top 10 schools by NULL ISBN13 row count (catalog), with proportion of NULL vs total.'
}

Table __data_quality_pricing_match_by_period {
  period_sortable varchar
  pricing_rows bigint
  rows_matched bigint
  match_pct double

  Note: 'Pricing rows that found a (section_id, isbn13) match in catalog, by period.'
}

Table __data_quality_top_unmatched_pricing_sections {
  unit_id integer
  period_sortable varchar
  pricing_sections bigint
  unmatched bigint
  unmatched_pct double

  Note: 'Top 10 (unit_id, period) combos by unmatched pricing sections (is_required_inferred=FALSE only).'
}

Table __data_quality_format_count_distribution {
  format_count integer
  pricing_wide_rows bigint

  Note: 'Distribution of format_count values in pricing_wide.'
}

TableGroup data_quality {
  __data_quality_metrics
  __data_quality_top_unmatched_ipeds_schools
  __data_quality_top_null_isbn_schools
  __data_quality_null_isbn_breakdown
  __data_quality_pricing_match_by_period
  __data_quality_top_unmatched_pricing_sections
  __data_quality_format_count_distribution
}
